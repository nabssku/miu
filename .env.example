# Salin menjadi `.env` untuk lokal atau isi di Vercel Dashboard -> Project Settings -> Environment Variables

# Cloud Catatan Database (Server-only, rahasia aman di server Vercel)
NEON_DATABASE_URL=postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Google Identity Services (Public OAuth Client ID untuk tombol Login Google)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com

# Media Cloud Upload (Server-only, gunakan API Key + Secret atau Upload Preset)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=

# Groq Default AI (Server-only proxy via /api/ai/chat)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=qwen/qwen3.8-27b

# ElevenLabs Conversational Voice AI (Opsional di server; bisa juga diisi lewat UI BYOK)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_CUSTOM_LLM_SECRET=

# SEO & Verifikasi Google Search Console (Opsional; default site URL: https://miu.kodelokal.store)
NEXT_PUBLIC_SITE_URL=https://miu.kodelokal.store
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
